# ---- Backpack Exchange API (ED25519). Create at backpack.exchange -> Settings -> API Keys
# Base64 32-byte seed (the "Seed" the docs' python one-liner prints). Public key is derived automatically.
BP_API_SECRET=
# Optional: override derived base64 public key
BP_API_KEY=

# ---- Solana
RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key (Phantom/Backpack wallet export) or JSON byte array. Needed only for on-chain execution.
SOLANA_SECRET_KEY=

# ---- Jupiter: "lite" (lite-api.jup.ag /swap/v1, no key) or "ultra" (lite-api.jup.ag /ultra/v1, no key)
JUPITER_MODE=lite
# Optional api.jup.ag key (only used if set; enables /swap/v2)
JUPITER_API_KEY=

# ---- Monitor
# Comma-separated Backpack asset symbols to watch. Empty = all Solana deposit+withdraw enabled stocks.
WATCH=SPCX.US,MU.US,SNDK.US,SKHY.US,MSTR.US,MRNA.US
# Comparison quantity in shares (same quantity used on both venues)
QTY=1
POLL_MS=5000
# Comparison quantities (shares) logged per poll; fixed-fee dilution vs depth consumption
QTYS=1,10
# Net edge threshold (bps of cost basis, after all costs) to flag an opportunity. On the RFQ route the
# expected-basis edge must also clear RFQ_SETTLE_VAR_BPS (settlement deviation from mid, measured ±5).
EDGE_BPS=10
RFQ_QUOTE_SPREAD_BPS=30   # quoted bid/ask width (measured 30.6 on 2026-09-09); settlement lands near mid
RFQ_SETTLE_VAR_BPS=5

# ---- Cost assumptions
BP_SPOT_FEE_BPS=0          # docs: no commission on stock spot; keep configurable
SOL_TX_FEE_USD=0.05        # per on-chain tx (swap / transfer) incl. priority fee, rough
JUP_ULTRA_FEE_BPS=10       # Ultra router fee observed in /ultra/v1/order (feeBps)
